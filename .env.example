# ============================================================
# Environment Variables — Instagram Reels Control Panel
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit your .env file to version control.
# ============================================================

# ----------------------------------------------------------------
# API Server (artifacts/api-server)
# ----------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/reels_panel

# [REQUIRED] Secret key used to sign JWT session tokens.
# Must be at least 32 characters of random data.
# Generate one with: openssl rand -hex 32
# The server will REFUSE TO START if this is missing or too short.
SESSION_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# [OPTIONAL] Allowed CORS origin for the API server (production only).
# Set to the exact URL of your frontend (e.g. https://yourapp.replit.app).
# If unset in development, all origins are allowed.
# In production this MUST be set to prevent unauthorized cross-origin requests.
# CORS_ORIGIN=https://yourapp.replit.app

# [OPTIONAL] Node environment. Set to "production" in deployed environments.
# Controls: secure cookies, CORS strictness, error detail in responses.
# NODE_ENV=production

# [OPTIONAL] Log level. One of: trace, debug, info, warn, error, fatal
# LOG_LEVEL=info

# ----------------------------------------------------------------
# Frontend (artifacts/reels-panel)
# ----------------------------------------------------------------

# [REQUIRED] Base URL of the API server, as seen by the browser.
# In Replit, the proxy exposes both frontend and API on the same domain.
# Typically /api or https://yourdomain.replit.app/api
VITE_API_BASE_URL=/api
