# ============================================================
# Environment Variables — Instagram Reels Control Panel
# ============================================================
# Copy this file to .env and fill in all required values.
#   cp .env.example .env
# NEVER commit your .env file to version control.
# ============================================================

# ----------------------------------------------------------------
# [REQUIRED] Database
# ----------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/reels_panel

# ----------------------------------------------------------------
# [REQUIRED] Security
# ----------------------------------------------------------------

# Secret key used to sign JWT session tokens.
# Must be at least 32 characters of random data.
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ----------------------------------------------------------------
# [REQUIRED] Server
# ----------------------------------------------------------------

# Port the API server listens on
PORT=3000

# Set to "production" on VPS / deployed environments.
# Controls: secure cookies, CORS enforcement, error verbosity, rate limiting.
NODE_ENV=production

# ----------------------------------------------------------------
# [OPTIONAL] CORS — required if frontend is on a different domain
# ----------------------------------------------------------------

# Exact origin of your frontend (no trailing slash).
# In production with backend serving frontend, leave this unset.
# Example: CORS_ORIGIN=https://panel.example.com
# CORS_ORIGIN=

# ----------------------------------------------------------------
# [OPTIONAL] Logging
# ----------------------------------------------------------------

# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# ----------------------------------------------------------------
# [OPTIONAL] Frontend static directory override
# ----------------------------------------------------------------

# Absolute path to the built frontend files.
# Default (after running build:prod): artifacts/api-server/dist/public
# Only set this if you host frontend files elsewhere.
# FRONTEND_DIST_DIR=/var/www/reels-panel/public
